{
  "schemaVersion": 1,
  "kit": "deliveries",
  "promisePolicies": [
    {
      "key": "camisa-padrao",
      "name": "Envio de camisa padrão",
      "minBusinessDays": 4,
      "maxBusinessDays": 10,
      "approachingBusinessDays": 3,
      "isDefault": true
    }
  ],
  "codeSequences": [
    {
      "key": "deliveries",
      "prefix": "CAM-DEL",
      "padding": 6,
      "nextNumber": 1,
      "template": "{prefix}-{number}"
    }
  ],
  "statuses": [
    {
      "key": "waiting",
      "label": "Aguardando envio",
      "isInitial": true,
      "allowedNextKeys": ["shipped", "cancelled"],
      "sortOrder": 1
    },
    {
      "key": "shipped",
      "label": "Enviado",
      "allowedNextKeys": ["delivered"],
      "sortOrder": 2
    },
    {
      "key": "delivered",
      "label": "Entregue",
      "isTerminal": true,
      "effects": { "confirmDelivery": true },
      "metadata": { "deliveryPromiseOutcome": "fulfilled" },
      "sortOrder": 3
    },
    {
      "key": "cancelled",
      "label": "Cancelado",
      "isTerminal": true,
      "sortOrder": 99,
      "metadata": { "deliveryPromiseOutcome": "closed" }
    }
  ],
  "deliveries": []
}
