{
  "schemaVersion": 1,
  "kit": "deliveries",
  "promisePolicies": [
    {
      "key": "transporte-bike-padrao",
      "name": "Transporte de bike padrão",
      "minBusinessDays": 3,
      "maxBusinessDays": 7,
      "approachingBusinessDays": 2,
      "isDefault": true
    }
  ],
  "codeSequences": [
    {
      "key": "deliveries",
      "prefix": "BIKE-DEL",
      "padding": 5,
      "nextNumber": 1,
      "template": "{prefix}-{number}"
    }
  ],
  "statuses": [
    {
      "key": "created",
      "label": "Criada",
      "isInitial": true,
      "allowedNextKeys": ["on-route", "cancelled"],
      "sortOrder": 1
    },
    {
      "key": "on-route",
      "label": "Em rota",
      "allowedNextKeys": ["received"],
      "sortOrder": 2
    },
    {
      "key": "received",
      "label": "Recebida",
      "isTerminal": true,
      "effects": { "confirmDelivery": true },
      "metadata": { "deliveryPromiseOutcome": "fulfilled" },
      "sortOrder": 3
    },
    {
      "key": "cancelled",
      "label": "Cancelada",
      "isTerminal": true,
      "sortOrder": 99,
      "metadata": { "deliveryPromiseOutcome": "closed" }
    }
  ],
  "deliveries": []
}
