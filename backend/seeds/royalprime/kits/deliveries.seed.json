{
  "schemaVersion": 1,
  "kit": "deliveries",
  "codeSequences": [
    {
      "key": "deliveries",
      "prefix": "DEL",
      "padding": 6,
      "nextNumber": 1,
      "template": "{prefix}-{number}"
    }
  ],
  "statuses": [
    {
      "key": "pending",
      "label": "Pendente",
      "isInitial": true,
      "allowedNextKeys": ["packing", "cancelled"],
      "metadata": { "ui": { "statusColor": "pending", "statusTone": "warning" } },
      "sortOrder": 1
    },
    {
      "key": "packing",
      "label": "Separando entrega",
      "allowedNextKeys": ["out-for-delivery", "cancelled"],
      "metadata": { "ui": { "statusColor": "separating", "statusTone": "warning" } },
      "sortOrder": 2
    },
    {
      "key": "out-for-delivery",
      "label": "Saiu para entrega",
      "allowedNextKeys": ["delivered", "failed"],
      "metadata": { "ui": { "statusColor": "outForDelivery", "statusTone": "primary" } },
      "sortOrder": 3
    },
    {
      "key": "delivered",
      "label": "Entregue",
      "isTerminal": true,
      "effects": { "confirmDelivery": true },
      "metadata": { "ui": { "statusColor": "active", "statusTone": "success" } },
      "sortOrder": 4
    },
    {
      "key": "failed",
      "label": "Falhou",
      "isTerminal": true,
      "metadata": { "ui": { "statusColor": "canceled", "statusTone": "danger" } },
      "sortOrder": 98
    },
    {
      "key": "cancelled",
      "label": "Cancelada",
      "isTerminal": true,
      "metadata": { "ui": { "statusColor": "canceled", "statusTone": "danger" } },
      "sortOrder": 99
    }
  ],
