# RoyalPrime Backend Environment

# Django
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
# Use sqlite for the first local scaffold, postgres for product-like development.
DATABASE_ENGINE=sqlite
DATABASE_NAME=royalprime.sqlite3
DATABASE_URL=

# PostgreSQL target example
DATABASE_POSTGRES_NAME=royalprime
DATABASE_POSTGRES_USER=postgres
DATABASE_POSTGRES_PASSWORD=postgres
DATABASE_POSTGRES_HOST=localhost
DATABASE_POSTGRES_PORT=5432

# Production target
# Vercel hosts frontend, Render hosts Django API, Supabase hosts PostgreSQL.
DEPLOY_FRONTEND_PROVIDER=vercel
DEPLOY_API_PROVIDER=render
DEPLOY_DATABASE_PROVIDER=supabase
SUPABASE_DATABASE_URL=
RENDER_EXTERNAL_URL=
VERCEL_CLIENT_URL=
VERCEL_ADMIN_URL=

# Organization seed
ROYALPRIME_DEFAULT_ORGANIZATION_SLUG=royalprime
ROYALPRIME_DEFAULT_ORGANIZATION_NAME=RoyalPrime
ROYALPRIME_DEFAULT_BUSINESS_NAME=Royal Carnes
ROYALPRIME_DEFAULT_LOCALE=pt-BR
ROYALPRIME_DEFAULT_TIMEZONE=America/Sao_Paulo
ROYALPRIME_DEFAULT_CURRENCY=BRL

# API
API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# Integrations - empty until implemented
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_API_KEY=
STORAGE_PUBLIC_BASE_URL=
